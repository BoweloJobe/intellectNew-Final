# Test-mode environment overrides — committed, not secret.
#
# Vite loads env files in this precedence order (later wins):
#   .env  →  .env.local  →  .env.[mode]  →  .env.[mode].local
#
# Vitest sets mode = "test", so this file is loaded AFTER .env.local.
# That means the empty values below override any per-domain adapter mode
# overrides a developer has set in their local .env.local, giving every
# vitest run a clean, deterministic baseline where:
#   • all domains default to mock
#   • vi.stubEnv() inside individual tests is the only override mechanism
#
# Never put secrets or real URLs here; this file is committed to source control.

VITE_SERVICE_ADAPTER_MODE=mock

# Reset every per-domain override to empty (empty string → "mock" in normalizer)
VITE_AUTH_ADAPTER_MODE=
VITE_COURSES_ADAPTER_MODE=
VITE_LESSONS_ADAPTER_MODE=
VITE_QUIZZES_ADAPTER_MODE=
VITE_PROGRESS_ADAPTER_MODE=
VITE_SUBSCRIPTION_ADAPTER_MODE=
VITE_NOTIFICATIONS_ADAPTER_MODE=
VITE_NOTES_ADAPTER_MODE=
VITE_DASHBOARD_ADAPTER_MODE=
VITE_COMMUNITY_ADAPTER_MODE=
VITE_TUTOR_ADAPTER_MODE=

# Blank out any real API coordinates so tests never accidentally hit a backend
VITE_API_BASE_URL=
VITE_API_TIMEOUT=
