datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// SQLite note: enums are stored as String, Json fields as String (serialized in app code).

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String
  role         String   @default("STUDENT")
  avatarUrl    String?
  bio          String?
  institution  String?
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResetTokens    PasswordResetToken[]
  courses                Course[]
  enrollments            Enrollment[]
  lessonProgress         LessonProgress[]
  quizAttempts           QuizAttempt[]
  payments               Payment[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  subscriptions          Subscription[]
  notes                  Note[]
  savedCourses           SavedCourse[]
  lessonWatchProgress    LessonWatchProgress[]
  posts                  Post[]
  postLikes              PostLike[]
  postBookmarks          PostBookmark[]
  standaloneQuizzes      Quiz[]                  @relation("StandaloneQuizInstructor")

  @@map("users")
}

model Note {
  id        Int      @id @default(autoincrement())
  userId    String
  title     String
  content   String
  course    String
  tags      String   @default("[]")
  starred   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("notes")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Course {
  id              String    @id @default(cuid())
  instructorId    String
  title           String
  description     String
  category        String
  difficulty      String    @default("BEGINNER")
  thumbnailUrl    String?
  estimatedHours  Float?
  price           Float?
  status          String    @default("DRAFT")
  rejectionReason String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  instructor  User           @relation(fields: [instructorId], references: [id])
  modules     CourseModule[]
  enrollments Enrollment[]
  payments    Payment[]
  savedBy     SavedCourse[]
  lessonWatchProgress LessonWatchProgress[]

  @@map("courses")
}

model SavedCourse {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, createdAt])
  @@map("saved_courses")
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("course_modules")
}

model Lesson {
  id                String   @id @default(cuid())
  moduleId          String
  courseId          String
  title             String
  description       String?
  notes             String?
  videoUrl          String?
  videoDurationSecs Int?
  estimatedMinutes  Int?
  order             Int
  isFree            Boolean  @default(false)
  // Video storage metadata — populated via the video-upload flow
  videoStorageKey   String? // internal bucket path, never sent to students
  videoProvider     String? // e.g. 'SUPABASE' | 'EXTERNAL'
  videoUploadStatus String? // 'PENDING' | 'READY' | 'FAILED'
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quiz     Quiz?
  progress LessonProgress[]
  watchProgress LessonWatchProgress[]

  @@map("lessons")
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  paymentId   String?   @unique
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  courseId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model LessonWatchProgress {
  id                  String   @id @default(cuid())
  userId              String
  lessonId            String
  courseId            String
  watchedSeconds      Int      @default(0)
  lastPositionSeconds Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
  @@map("lesson_watch_progress")
}

model Quiz {
  id               String   @id @default(cuid())
  lessonId         String?  @unique
  // Standalone quizzes (not lesson-bound) are owned directly by the instructor
  instructorId     String?
  title            String
  description      String?
  passingScore     Int      @default(70)
  // Optional countdown timer; null means untimed
  timeLimitSeconds Int?
  // Premium-gated standalone quizzes require a Pro subscription to access
  isPremium        Boolean  @default(false)
  // Subject/category label for standalone quizzes (lesson-bound quizzes derive this from the course)
  category         String?
  // Difficulty level for standalone quizzes: Easy | Medium | Hard
  difficulty       String   @default("Medium")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lesson     Lesson?        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  instructor User?          @relation("StandaloneQuizInstructor", fields: [instructorId], references: [id])
  questions  QuizQuestion[]
  attempts   QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id           String   @id @default(cuid())
  quizId       String
  text         String
  explanation  String?
  order        Int
  // "MCQ" (multiple-choice) or "SHORT_ANSWER" (free-text, not auto-graded)
  questionType String   @default("MCQ")
  // Comma-separated grading keywords for SHORT_ANSWER questions.
  // Each keyword counts as one mark. Example: "photosynthesis, chlorophyll, glucose"
  // Never exposed to students; used only during backend grading.
  answerKey    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quiz           Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options        QuizOption[]
  attemptAnswers QuizAttemptAnswer[]

  @@map("quiz_questions")
}

model QuizOption {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  order      Int
  createdAt  DateTime @default(now())

  question       QuizQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptAnswers QuizAttemptAnswer[]

  @@map("quiz_options")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  score       Int      @default(0)
  passed      Boolean  @default(false)
  status      String   @default("IN_PROGRESS")
  startedAt   DateTime @default(now())
  expiresAt   DateTime?
  submittedAt DateTime @default(now())

  quiz    Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAttemptAnswer[]

  @@index([quizId, userId, status])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id               String  @id @default(cuid())
  attemptId        String
  questionId       String
  // MCQ: the chosen option id; null for SHORT_ANSWER questions
  selectedOptionId String?
  // SHORT_ANSWER: the raw student text; null for MCQ questions
  textAnswer       String?
  isCorrect        Boolean
  // Marks earned for this answer (1 for correct MCQ; 0–N for SHORT_ANSWER keywords)
  marksAwarded     Int     @default(0)

  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       QuizQuestion @relation(fields: [questionId], references: [id])
  selectedOption QuizOption?  @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("quiz_attempt_answers")
}

model Payment {
  id         String    @id @default(cuid())
  userId     String
  courseId   String
  amount     Float
  currency   String    @default("USD")
  status     String    @default("PENDING")
  provider   String
  providerId String    @unique
  capturedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course      @relation(fields: [courseId], references: [id])
  enrollment Enrollment?

  @@map("payments")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  metadata  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationPreference {
  userId               String   @id
  courseUpdates        Boolean  @default(true)
  quizReminders        Boolean  @default(true)
  assignmentDeadlines  Boolean  @default(true)
  communityActivity    Boolean  @default(false)
  weeklyProgressReport Boolean  @default(true)
  emailNotifications   Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  tier                   String    @default("PREMIUM")
  status                 String    @default("PENDING")
  billingCycle           String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  provider               String?
  providerSubscriptionId String?   @unique
  providerPlanId         String?
  canceledAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  events SubscriptionEvent[]

  @@index([userId, status])
  @@map("subscriptions")
}

// ── Community ──────────────────────────────────────────────────────────────

model Post {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  body      String
  category  String   @default("General")
  // PUBLISHED | HIDDEN (admin moderation)
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     PostLike[]
  bookmarks PostBookmark[]

  @@map("posts")
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_likes")
}

model PostBookmark {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_bookmarks")
}

model SubscriptionEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  event          String
  metadata       String?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_events")
}
