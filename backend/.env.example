# Use NODE_ENV=production on deployed backend hosts.
NODE_ENV=development
PORT=4000

# PostgreSQL is required by Prisma in development and production.
# Local development can use a local Docker/native PostgreSQL instance.
# Production must use a managed PostgreSQL database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intellectx_dev?schema=public"

# Authentication
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend
# Set this to the deployed frontend origin in production for CORS.
FRONTEND_URL=http://localhost:5173

# SMTP Email
# Production default: enabled. Set ENABLE_EMAIL_DELIVERY=false only when
# password reset/email delivery is intentionally unavailable.
ENABLE_EMAIL_DELIVERY=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@intellectx.app
# Development only: logs password reset links when SMTP is missing.
# Never enable in production.
ALLOW_DEV_RESET_LINK_LOGGING=false

# PayPal
# Production default: enabled. Set ENABLE_PAYMENTS=false only when paid
# courses/subscription checkout are intentionally unavailable.
ENABLE_PAYMENTS=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox   # or live

# PayPal Subscription Billing Plans (create in PayPal dashboard → Products & Plans)
# Leave blank during development — checkout sessions will be created without a live URL
PAYPAL_PLAN_ID_MONTHLY=
PAYPAL_PLAN_ID_ANNUAL=

# Subscription pricing (used in checkout response; must match PayPal plan amounts)
SUBSCRIPTION_MONTHLY_PRICE=9.99
SUBSCRIPTION_ANNUAL_PRICE=99.99

# Lesson video uploads (Supabase Storage)
# Production default: enabled. Set ENABLE_VIDEO_UPLOADS=false only when
# instructor lesson video uploads are intentionally unavailable.
ENABLE_VIDEO_UPLOADS=false
STORAGE_PROVIDER=SUPABASE
STORAGE_BUCKET=lesson-videos
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
