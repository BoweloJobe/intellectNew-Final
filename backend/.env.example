# Use NODE_ENV=production on deployed backend hosts.
NODE_ENV=development
PORT=4000

# SQLite (used in development; schema.prisma uses provider = "sqlite")
# Local .db files are ignored by git and must not be committed.
# PostgreSQL is the intended production target, but migrations are not implemented yet.
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend
# Set this to the deployed frontend origin in production for CORS.
FRONTEND_URL=http://localhost:5173

# SMTP Email
# Required in production for password reset delivery. Missing SMTP fails closed.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@intellectx.app
# Development only: logs password reset links when SMTP is missing.
# Never enable in production.
ALLOW_DEV_RESET_LINK_LOGGING=false

# PayPal
# Required only for deployments with payments enabled. Leave blank for
# non-payment testing environments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox   # or live

# PayPal Subscription Billing Plans (create in PayPal dashboard → Products & Plans)
# Leave blank during development — checkout sessions will be created without a live URL
PAYPAL_PLAN_ID_MONTHLY=
PAYPAL_PLAN_ID_ANNUAL=

# Subscription pricing (used in checkout response; must match PayPal plan amounts)
SUBSCRIPTION_MONTHLY_PRICE=9.99
SUBSCRIPTION_ANNUAL_PRICE=99.99

# Lesson video uploads (Supabase Storage)
# When these are blank, video upload endpoints fail with "storage not configured".
STORAGE_PROVIDER=SUPABASE
STORAGE_BUCKET=lesson-videos
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
