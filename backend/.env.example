NODE_ENV=development
PORT=4000

# SQLite (used in development; schema.prisma uses provider = "sqlite")
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=http://localhost:5173

# SMTP Email (leave blank in dev to fall back to console logging)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@intellectx.app

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox   # or live

# PayPal Subscription Billing Plans (create in PayPal dashboard → Products & Plans)
# Leave blank during development — checkout sessions will be created without a live URL
PAYPAL_PLAN_ID_MONTHLY=
PAYPAL_PLAN_ID_ANNUAL=

# Subscription pricing (used in checkout response; must match PayPal plan amounts)
SUBSCRIPTION_MONTHLY_PRICE=9.99
SUBSCRIPTION_ANNUAL_PRICE=99.99

# Supabase Storage (fill in when ready)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
