# Copy this file to .env.local and fill in values for your environment.
# Never commit .env or .env.local – they are git-ignored.

# -----------------------------------------------------------------------
# Service adapter mode
# "mock"  – uses in-memory mock data (default, no backend required)
# "api"   – proxies all service calls through VITE_API_BASE_URL
# This is the global fallback used by any domain that does not have its
# own override set below.
# Production builds fail if any adapter resolves to "mock" unless
# VITE_ALLOW_MOCK_IN_PRODUCTION=true is set intentionally for a demo build.
# -----------------------------------------------------------------------
VITE_SERVICE_ADAPTER_MODE=mock

# Explicit production demo/mock escape hatch.
# Keep this unset/false for real production.
VITE_ALLOW_MOCK_IN_PRODUCTION=false

# -----------------------------------------------------------------------
# Per-domain adapter mode overrides
# Each domain can be independently set to "mock" or "api".
# Unset (or any invalid value) falls back to VITE_SERVICE_ADAPTER_MODE.
# This allows safe incremental backend integration: flip one domain to
# "api" while all others remain on "mock".
#
# To activate one domain against the backend:
#   VITE_AUTH_ADAPTER_MODE=api
#   VITE_API_BASE_URL=http://localhost:4000/api   ← backend must be running
#
# Instructor course creation and video upload testing require API-backed
# courses. For that workflow, set either:
#   VITE_SERVICE_ADAPTER_MODE=api
# or:
#   VITE_COURSES_ADAPTER_MODE=api
# plus VITE_API_BASE_URL.
# Mock mode can create local in-memory drafts for UI testing, but real
# persistence and lesson video uploads require API mode.
# -----------------------------------------------------------------------
#VITE_AUTH_ADAPTER_MODE=mock
#VITE_COURSES_ADAPTER_MODE=mock
#VITE_LESSONS_ADAPTER_MODE=mock
#VITE_QUIZZES_ADAPTER_MODE=mock
#VITE_PROGRESS_ADAPTER_MODE=mock
#VITE_SUBSCRIPTION_ADAPTER_MODE=mock
#VITE_NOTIFICATIONS_ADAPTER_MODE=mock
#VITE_NOTES_ADAPTER_MODE=mock
#VITE_DASHBOARD_ADAPTER_MODE=mock
#VITE_COMMUNITY_ADAPTER_MODE=mock
#VITE_TUTOR_ADAPTER_MODE=mock

# -----------------------------------------------------------------------
# API base URL (only required when VITE_SERVICE_ADAPTER_MODE=api or any
# domain override above is set to "api")
# Must NOT have a trailing slash – it will be stripped if present.
# In production, missing this value while api mode is enabled will fail fast.
# -----------------------------------------------------------------------
VITE_API_BASE_URL=

# -----------------------------------------------------------------------
# API request timeout in milliseconds (default: 10000)
# Must be a positive integer; invalid values fall back to the default.
# -----------------------------------------------------------------------
VITE_API_TIMEOUT=10000

# -----------------------------------------------------------------------
# Production example
# -----------------------------------------------------------------------
# VITE_SERVICE_ADAPTER_MODE=api
# VITE_API_BASE_URL=https://api.example.com/api
# VITE_ALLOW_MOCK_IN_PRODUCTION=false
